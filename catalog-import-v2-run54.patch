+  const dir=fs.mkdtempSync(path.join(os.tmpdir(),"vag-tech-pro-v1-migration-"));
+  t.after(()=>fs.rmSync(dir,{recursive:true,force:true}));
+  const dbPath=path.join(dir,"user.sqlite"), db=new DatabaseSync(dbPath);
+  const now=new Date().toISOString();
+  db.exec(core.MIGRATION_1);
+  db.prepare("INSERT INTO app_meta(key,value) VALUES('app_id',?),('created_at',?)").run(core.APP_ID,now);
+  db.prepare("INSERT INTO schema_migrations(version,name,checksum,applied_at) VALUES(1,?,?,?)").run("local-core-v1",core.sha256(core.MIGRATION_1),now);
+  db.prepare("INSERT INTO local_user_vehicles(nickname,brand_name,model_name,market_scope,identity_status,is_default,created_at,updated_at) VALUES('My Golf','Volkswagen','Golf','RU','user_declared_unverified',1,?,?)").run(now,now);
