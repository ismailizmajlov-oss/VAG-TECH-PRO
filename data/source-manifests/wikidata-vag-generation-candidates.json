    "review_status": "candidate",
    "generation_verified": false,
    "exact_vehicle_fitment": false,
    "engine_code_fitment": false,
    "transmission_code_fitment": false,
    "ecu_fitment": false,
    "dtc_fitment": false,
    "repair_procedure_fitment": false,
    "diagnostic_execution_allowed": false,
    "production_years_inferred": false,
    "completeness_status": "unknown"
  },
  "exclusions": [
    "P179/P527 links are series-member candidates, not verified vehicle generations.",
    "Member instance types are retained as source evidence but are not used to certify a generation.",
    "P571/P576/P580/P582 dates remain raw property statements; no production-year ranges are inferred.",
    "No Russian/EAEU market scope or exact vehicle fitment.",
    "No engine or gearbox codes, ECU identities, DTC definitions, diagnostic test plans or execution commands.",
    "No repair procedures, wiring diagrams, pinouts, torque values, adaptations or OEM part numbers.",
    "No article text, images, logos or third-party linked resources."
