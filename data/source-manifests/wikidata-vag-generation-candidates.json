    "parent_model_source_id": "wikidata-vag-model-taxonomy",
    "relationship_properties": [
      "P179",
      "P527"
    ],
    "query_batch_size": 50,
    "query_limit_per_batch": 5000,
    "query_limit_scope": "per_batch",
