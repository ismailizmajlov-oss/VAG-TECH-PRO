{
  "schema_version": 1,
  "source_id": "wikidata-vag-model-taxonomy",
  "publisher": "Wikidata / Wikimedia Foundation",
  "source_url": "https://www.wikidata.org/",
  "endpoint_url": "https://query.wikidata.org/sparql",
  "license": {
    "id": "CC0-1.0",
    "url": "https://creativecommons.org/publicdomain/zero/1.0/",
    "rights_status": "approved_by_published_license",
    "commercial_use_allowed": true,
    "display_allowed": true,
    "offline_cache_allowed": true,
    "bulk_reuse_allowed": true,
    "redistribution_allowed": true,
    "attribution_required": false,
    "attribution_recommended": true,
    "share_alike_required": false,
    "scope_note": "Applies to structured Wikidata statements only; not article text, images, logos or linked third-party resources."
  },
  "acquisition": {
    "method": "SPARQL POST",
    "query_file": "scripts/build_wikidata_vag_taxonomy.py:SPARQL_QUERY",
    "manufacturer_whitelist": [
      "Volkswagen",
      "Volkswagen AG",
      "Volkswagen Commercial Vehicles",
      "Audi AG",
      "Škoda Auto",
      "SEAT",
      "SEAT S.A.",
      "Porsche AG",
      "Bentley Motors Limited",
      "Automobili Lamborghini S.p.A.",
      "Bugatti Rimac"
    ],
    "entity_type": "car model (Q3231690), direct P31 statement only",
    "snapshot_sha256_required": true,
    "query_sha256_required": true,
    "per_binding_sha256_required": true,
    "query_limit": 3000,
    "completeness_status": "unknown"
  },
  "applicability": {
    "market_scope": "UNKNOWN",
    "precision": "candidate_identity_only",
    "review_status": "candidate",
    "exact_vehicle_fitment": false,
    "generation_verified": false,
    "engine_code_fitment": false,
    "transmission_code_fitment": false,
    "ecu_fitment": false,
    "dtc_fitment": false,
    "repair_procedure_fitment": false,
    "diagnostic_execution_allowed": false,
    "production_years_inferred": false,
    "completeness_status": "unknown"
  },
  "exclusions": [
    "No engine or gearbox codes",
    "No ECU identities",
    "No DTC definitions or descriptions",
    "No diagnostic test plans or execution commands",
    "No repair procedures",
    "No wiring diagrams or pinouts",
    "No torque values or adaptations",
    "No OEM part numbers",
    "No market scope",
    "No exact vehicle fitment",
    "No verified generation mapping",
    "No article text or images"
  ]
}
