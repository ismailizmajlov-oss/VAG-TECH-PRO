  "applicability_policy": {
    "market_scope": "CH only",
    "approval_level": "type approval only",
    "variant_version": "preserve raw variant and version; if version or versionDefined is '*', mark wildcard and do not claim exact version fitment",
    "engine_gearbox_pair": "Link an emissions/gearbox row only when its versionDefined exactly equals the same unique approval's raw variant/version composite and its chGearboxType is listed in that approval's gearboxEmissionsN.chGearboxType values. A '*' in variant or version remains wildcard scope. This is a CH approval-scope association only, not proof of a VAG factory engine/gearbox code pair or production fitment; never cross-join variants.",
    "model_generation_year": "preserve dateOfApproval separately; it is not a vehicle model year or production-year range",
    "vin_fitment": false,
    "individual_vehicle_fitment": false,
    "repair_procedure_applicability": false,
    "diagnostic_execution_allowed": false,
    "production_fitment_status": "approval_level_ch_research_evidence_only",
    "research_pack_status": "builder_implemented; full CI pack artifact not yet verified or recorded; separate CH-only research evidence; no RU/EAEU or production fitment",
    "engine_type": "preserve engineType as the official approval engine-type designation; do not relabel it as a confirmed VAG engine code without independent corroboration",
    "stamped_engine_marking": "preserve chEngineCodeAsMarkedOnTheEngine separately; sample values DNP/DPC/DNF/EBJ/ECW show it can be shorter than engineType",
    "gearbox": "preserve chGearboxType as Swiss type-approval gearbox classification; it is not a VAG gearbox code",
