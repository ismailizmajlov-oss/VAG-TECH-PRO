  "field_semantics": {
    "make_model": "merk and handelsbenaming are NL registration-dataset labels. They support NL observed make/trade-name identity only, not model generation or worldwide market applicability.",
    "type_approval": "typegoedkeuringsnummer is the EU type-approval identifier. Variant, uitvoering and revision are preserved as separate exact raw fields.",
    "engine_designation": "motorcode is preserved exactly as RDW publishes it. Until independently corroborated against an OEM source, it is an RDW engine designation candidate, not a confirmed VAG factory engine code.",
    "gearbox_classification": "codetypeversnellingsbak is preserved exactly as RDW publishes it. It is an approval gearbox-type classification, not a VAG gearbox code.",
    "model_year": "datum_eerste_toelating is a first-registration date, not model year or production date. It must not populate model_year.",
    "manufacturer_trade_name": "handelsbenamingfabrikant and typeaanduidingfabrikant are approval/manufacturer trade-name fields, not generation identifiers."
  },
  "applicability_policy": {
    "exact_scope_key": [
      "typegoedkeuringsnummer",
      "variant/codevarianttgk",
      "uitvoering/codeuitvoeringtgk",
      "volgnummer_wijziging_eu_typegoedkeuring/volgnummerrevisieuitvoering"
    ],
    "join_policy": "Only associate a source row with the exact same approval number, variant, version and revision. Preserve raw values. The exact key identifies approval scope only.",
    "engine_gearbox_pairing": "NEVER cross-join engine rows and gearbox rows. Separate child datasets do not establish an exact engine/gearbox pair, even when both contain the same approval-scope key. No pair table or pairing claim may be emitted.",
    "market_scope": "NL registration observations and EU type-approval identifiers; not RU/EAEU.",
    "model_year": "not_assumed",
    "generation": "not_assumed",
    "individual_vehicle_fitment": false,
    "vin_fitment": false,
    "production_fitment": false,
