{
  "schema_version": 1,
  "policy_id": "vag-tech-pro-dtc-namespace-ranges",
  "policy_revision": "run87-2026-11-08",
  "source_basis": [
    {
      "publisher": "SAE International",
      "document_id": "J2012_202509",
      "revision_date": "2025-09-01",
      "url": "https://saemobilus.sae.org/standards/j2012_202509-diagnostic-trouble-code-definitions"
    },
    {
      "publisher": "SAE International",
      "document_id": "J2012DA_012013",
      "current_revision": "J2012DA_202607",
      "revision_date": "2026-07-29",
      "url": "https://saemobilus.sae.org/standards/j2012da_012013-digital-annex-diagnostic-trouble-code-definitions-failure-type-byte-definitions"
    }
  ],
  "namespaces": {
    "generic_sae_iso": {
      "pattern": "^(?:P0[0-9A-F]{3}|P2[0-9A-F]{3}|P34[0-9A-F]{2}|B0[0-9A-F]{3}|C0[0-9A-F]{3}|U0[0-9A-F]{3})$",
      "exact_source_record_required_for": [
        "P34xx"
      ]
    },
    "manufacturer_controlled": {
      "pattern": "^(?:P1[0-9A-F]{3}|P3[0-3][0-9A-F]{2}|B[12][0-9A-F]{3}|C[12][0-9A-F]{3}|U[12][0-9A-F]{3})$"
    },
    "unresolved_reserved": {
      "pattern": "^(?:P3[5-9][0-9A-F]{2}|U3[0-9A-F]{3}|B3[0-9A-F]{3}|C3[0-9A-F]{3})$",
      "allowed_normalized_namespaces": []
    }
  },
  "quarantine_policy": {
    "unresolved_codes_may_be_retained_only_in": "unknown",
    "may_be_promoted_to_generic_or_manufacturer_specific": false,
    "require_exact_pinned_source_record_for_p34xx": true,
    "manufacturer_controlled_range_proves_vag_authorship": false
  },
  "notes": [
    "A manufacturer-controlled allocation range is not proof of Volkswagen Group authorship.",
    "P34xx is admitted as generic only when the exact identifier exists in the pinned source snapshot; a prefix alone is insufficient.",
    "P35xx-P39xx, U3xxx, B3xxx and C3xxx are unresolved/reserved for this importer and are not admitted to normalized generic or manufacturer-specific namespaces.",
    "The current SAE digital annex is licensed. No standard text, DTC definition table or allocation spreadsheet is copied into this repository."
  ]
}
