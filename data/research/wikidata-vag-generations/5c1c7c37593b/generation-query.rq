# batch 1/8; model_qids=50
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?model ?member ?relation ?memberLabelEn ?memberLabelRu ?memberType
                ?start ?end ?inception ?dissolution ?ordinal ?memberManufacturer
WHERE {
  VALUES ?model { wd:Q100326648 wd:Q10366488 wd:Q10392360 wd:Q10396630 wd:Q10403352 wd:Q10403396 wd:Q10403699 wd:Q10403726 wd:Q10403816 wd:Q10403838 wd:Q10403914 wd:Q10403941 wd:Q10404163 wd:Q10404175 wd:Q10404425 wd:Q10404450 wd:Q10422297 wd:Q104759550 wd:Q105044283 wd:Q106518090 wd:Q106580835 wd:Q106620903 wd:Q106793330 wd:Q107185864 wd:Q10750273 wd:Q108105425 wd:Q109315466 wd:Q109649502 wd:Q109814587 wd:Q109814588 wd:Q112056432 wd:Q1123579 wd:Q1128232 wd:Q113294587 wd:Q113677858 wd:Q1138766 wd:Q114878243 wd:Q117390 wd:Q11832265 wd:Q118840 wd:Q118911224 wd:Q1190050 wd:Q11946507 wd:Q11946509 wd:Q120278400 wd:Q12032400 wd:Q12032779 wd:Q12062534 wd:Q122382000 wd:Q12334261 }
  {
    ?member wdt:P179 ?model .
    BIND("P179" AS ?relation)
  }
  UNION
  {
    ?model wdt:P527 ?member .
    BIND("P527" AS ?relation)
  }
  FILTER(?member != ?model)
  ?member wdt:P31/wdt:P279* wd:Q3231690 .
  ?member rdfs:label ?memberLabelEn .
  FILTER(LANG(?memberLabelEn) = "en")
  OPTIONAL { ?member rdfs:label ?memberLabelRu . FILTER(LANG(?memberLabelRu) = "ru") }
  OPTIONAL { ?member wdt:P31 ?memberType . }
  OPTIONAL { ?member wdt:P580 ?start . }
  OPTIONAL { ?member wdt:P582 ?end . }
  OPTIONAL { ?member wdt:P571 ?inception . }
  OPTIONAL { ?member wdt:P576 ?dissolution . }
  OPTIONAL { ?member wdt:P1545 ?ordinal . }
  OPTIONAL { ?member wdt:P176 ?memberManufacturer . }
}
ORDER BY ?model ?member ?relation
LIMIT 5000


